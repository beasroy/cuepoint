OPENROUTER_API_KEY=
# The only transcriber: ElevenLabs Scribe (word timings, Bengali text, audio-event tags).
ELEVENLABS_API_KEY=
# Optional overrides (defaults live in server/src/config.ts)
# DATA_DIR=./data
# DB_PATH=./data/app.db   (SQLite: jobs, attempts, audit trail, model calls; defaults to DATA_DIR/app.db)
# QUEUE_CONCURRENCY=1      (pipelines running at once)
# CATALOGUE_PATH=data/catalogue/brands.json   (brands.json plus its ads/ folder; keep it under DATA_DIR so one volume holds everything persistent)
# PORT=4000
# PUBLIC_BASE_URL=http://localhost:4000
# SCRIBE_MODEL=scribe_v2
# SCRIBE_USD_PER_HOUR=0.22   (Scribe returns no price; cost in the audit is derived from this rate)
# MODEL_LISTEN=google/gemini-3.8-flash   (needs audio input: the listen check at a cut)
# MODEL_REASON=openai/gpt-5.6-luna
# LISTEN_CHECK_CUTS=true   (set to "false" to skip the speech check at each scheduled cut)
# LISTEN_LLM_RECHECK=true  (set to "false" to drop the audio LLM; the unsure VAD band then fails closed)
